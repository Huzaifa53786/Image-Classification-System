# Optional bearer token. Set a long random value before exposing the service publicly.
IMAGE_CLASSIFIER_API_TOKEN=

# Maximum uploaded image size in bytes (default: 10 MiB).
IMAGE_CLASSIFIER_MAX_UPLOAD_BYTES=10485760

# Maximum decoded image pixels (default: 40 million).
IMAGE_CLASSIFIER_MAX_IMAGE_PIXELS=40000000

# Optional persistent location for downloaded PyTorch weights.
# TORCH_HOME=/models

